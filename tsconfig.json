{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "es2022",
    "target": "es2022",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    // TypeScript 6 requires it once it emits. It was always src/ by inference, and must stay
    // so: dist/*.d.ts sit at the paths the exports map names (see tsconfig.bin.json).
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "types": [
      "bun-types" // add Bun global
    ]
  },
  "allowJs": true,
  "files": ["./node_modules/@types/react/index.d.ts"],
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.json"],
  "exclude": ["node_modules", "src/**/*.spec.ts", "src/**/*.test.ts"]
}

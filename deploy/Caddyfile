# Preview host — Caddy config.
#
# Committed on purpose: server config in git beats server config in someone's shell
# history. Install with `bun run deploy:caddy`, or scp to /etc/caddy/Caddyfile and
# `systemctl reload caddy`.
#
# ADDING A PROJECT IS ONE LINE (see the bottom). DNS is a wildcard set once
# (`*.dev.tosijs.net`), so a new project never needs a registrar visit.

{
	# Where Let's Encrypt sends expiry/problem notices. Caddy renews automatically, so
	# this is a safety net rather than an operational dependency.
	email tonio@loewald.com
}

# ── The shared site definition ───────────────────────────────────────────────
# NOTE: deliberately takes NO snippet arguments. Each site block sets its own `root`
# and then imports this. Snippet-argument syntax is version-specific — Caddy 2.6
# (Debian trixie) spells it `{args.0}` while 2.7+ uses `{args[0]}` — and getting it
# wrong does not error, it silently serves 404s from a non-existent directory. Since
# `root` is the only thing that varies, keeping it in the caller costs one line per
# project and makes this file work on any Caddy 2.x.
(preview_site) {
	file_server
	encode gzip zstd

	# Pages are pre-rendered to /slug/index.html, so this is mostly a no-op — but it
	# makes a miss render the site's own 404 instead of Caddy's.
	handle_errors {
		rewrite * /index.html
		file_server
	}

	# Cache policy in three MUTUALLY EXCLUSIVE buckets.
	#
	# They must not overlap. A bare `header Cache-Control ...` with no matcher applies
	# to every request and, being evaluated later, silently overwrites the specific
	# rules above it — which is exactly what happened on the first deploy: the one file
	# whose whole job is answering "what am I looking at" came back `no-cache` instead
	# of `no-store`. Hence the explicit `not` matchers rather than a bare directive.

	# Build identity — never cache. A stale commit here is worse than no answer.
	@version path /version.json
	header @version Cache-Control "no-store"

	# Hashed filenames are content-addressed, so they can be cached forever.
	@hashed path_regexp \-[a-z0-9]{8}\.(js|css|map)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else: revalidate, so a deploy is visible on reload.
	#
	# The exclusion repeats the regex verbatim rather than naming it: a named
	# `path_regexp <name> <pattern>` names a CAPTURE GROUP, it does not create a
	# reusable matcher, so `not path_regexp hashed` reads "not matching /hashed/" —
	# true for nearly every request. That made this rule match hashed assets too and
	# clobber their immutable header. Verified with curl against the live host.
	@rest {
		not path /version.json
		not path_regexp \-[a-z0-9]{8}\.(js|css|map)$
	}
	header @rest Cache-Control "no-cache"

	# ONE shared log for all previews — deliberately not per-project.
	#
	# `/var/log/caddy/{args[0]}.log` looks obvious and does not work: the file writer
	# resolves its filename when the module is PROVISIONED, before snippet arguments
	# are substituted, so it fails with "unrecognized placeholder {args[0]}". Worth
	# knowing that `caddy validate` still passes — it adapts the Caddyfile to JSON
	# without provisioning modules — so this only surfaces on reload, which then times
	# out while the old process keeps serving. Validation is not a load test.
	#
	# No real loss: the JSON log records the request host, so per-project filtering is
	# a `grep`.
	log {
		output file /var/log/caddy/preview.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# ── Named hosts with automatic HTTPS (current) ───────────────────────────────
# Caddy provisions a Let's Encrypt cert per hostname on first request via HTTP-01 and
# renews it automatically — no certbot, no cron, nothing to forget. It also redirects
# :80 → :443 for each name on its own.
#
# NOTE: with only named blocks, requests to the bare IP no longer match anything and
# get a 404 by design — use the hostname.
#
# WHY EXPLICIT HOSTNAMES RATHER THAN A `*.dev.tosijs.net` BLOCK:
# a true wildcard CERTIFICATE can only be issued over the DNS-01 challenge, which
# needs a Namecheap API token sitting on this public box. We are simultaneously
# trying to keep long-lived credentials OFF machines like this one, and one line per
# project — in git, reviewable — is a much better trade than a DNS credential here.
# The DNS wildcard still does its job: no registrar visit when a project is added.
#
# The ROOT is the index — a generated list of what is actually deployed, with the
# commit each preview is serving (deploy/build-index.sh). Deliberately NOT a redirect
# to the most-recently-deployed project: that would make one URL mean different things
# at different times depending on invisible state, which is the "what am I looking at"
# problem /version.json exists to kill, reintroduced at the routing layer. A link you
# send someone should still show what you meant an hour later.
dev.tosijs.net {
	root * /srv/preview/_index
	import preview_site
}

# ── Projects register THEMSELVES ─────────────────────────────────────────────
# Each project's deploy writes /srv/preview/_sites/<name>.caddy declaring its own
# hostname and root, and this glob picks it up. So adding a project touches no
# central file: `bun run deploy --go` from that project is the whole ceremony, and
# no DNS change is needed either (the *.dev wildcard already resolves).
#
# The fragment is the SINGLE SOURCE OF TRUTH for "which hostname serves which
# directory" — build-index.sh reads these same files to write its links, so the
# index cannot disagree with the router.
#
# Two consequences worth being explicit about:
#   - A project that can write a fragment can declare any hostname and serve any
#     path. Every project here already deploys with the same ssh key, so this grants
#     no new privilege — but it means this box trusts everything that can deploy to it.
#   - A malformed fragment fails the reload for EVERY project. The deploy therefore
#     validates before reloading and refuses to reload on invalid config, so a bad
#     fragment leaves the previous good config serving. Same rule as the dev server's
#     last-good build: never leave it broken.
import /srv/preview/_sites/*.caddy
#
# tosijs.dev.tosijs.net {
# 	root * /srv/preview/tosijs
# 	import preview_site
# }
#
# 3d.dev.tosijs.net {
# 	root * /srv/preview/tosijs-3d
# 	import preview_site
# }
#
# To keep unreleased work off the open internet, add to any block above. The stakes
# for a STATIC host are disclosure, not code execution — there is no write endpoint —
# so one line is a proportionate access-control design.
# Generate the hash with: caddy hash-password
# NOTE: Caddy 2.6 (Debian trixie) spells this `basicauth`; 2.8+ uses `basic_auth`.
#
# 	basicauth {
# 		dev <bcrypt-hash>
# 	}

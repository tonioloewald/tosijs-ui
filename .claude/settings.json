{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v virta >/dev/null 2>&1 || exit 0; virta brief"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v virta >/dev/null 2>&1 || exit 0; virta brief --changes"
          }
        ]
      }
    ]
  }
}

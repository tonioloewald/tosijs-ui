{
  // Type-check bin/ WITHOUT touching the emit.
  //
  // bin/ sat outside the gate and had accumulated two real type errors. The obvious fix
  // — adding the bin glob to tsconfig.json's `include` — silently repoints tsc's
  // inferred common root from src/ to the repo root, so declarations move from
  // dist/*.d.ts to dist/src/*.d.ts and every published subpath export breaks. (Tried it;
  // it relocated the entire shipped dist layout.) A separate no-emit project gets the
  // coverage with none of that.
  //
  // Line comments, not a block comment: the bin glob contains a star-slash, which
  // terminates a block comment early and makes this file invalid JSON.
  //
  // Listing only bin/ is deliberate: tsc follows the imports into src/ by itself, while
  // naming src/ here would also drag in the *.test.ts files the parent config excludes.
  "extends": "./tsconfig.json",
  // Shipped bins' relative imports carry the `.ts` extension, so the specifier names a file
  // that is actually packed rather than relying on Bun's extension probing. (Not for Node: it
  // refuses to strip types under node_modules at all, so installed bins are Bun-only either
  // way — measured on Node 22.) Legal here because this project is noEmit.
  "compilerOptions": { "noEmit": true, "allowImportingTsExtensions": true },
  // The prismjs grammar modules have no types (`@types/prismjs` covers the main module
  // only), and `src/doc-system/highlight.ts` names 27 of them. bin code imports that module
  // transitively, so this project needs the ambient declaration too. Safe here in a way the
  // note above forbids for tsconfig.json: this project is noEmit, so nothing relocates.
  "include": ["bin/**/*.ts", "src/prismjs-components.d.ts"]
}

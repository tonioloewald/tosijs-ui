{
  "name": "tosijs-ui",
  "version": "1.13.0",
  "description": "simple robust web-components for use with tosijs or anything else",
  "scripts": {
    "start": "bun --watch bin/dev.ts",
    "tls": "bash tls/create-dev-certs.sh",
    "build": "bun bin/dev.ts --build-only",
    "book": "bun bin/build-book.ts",
    "og": "bun bin/generate-og.ts",
    "deploy": "bun bin/deploy-preview.ts",
    "deploy:caddy": "bun bin/caddy-install.ts",
    "deploy:index": "ssh $PREVIEW_SSH 'bash -s' < deploy/build-index.sh",
    "tunnel": "bun bin/tunnel.ts",
    "test-browser": "bun bin/dev.ts --test",
    "test-consumer": "bun bin/smoke-consumer.ts",
    "format": "bun prettier --write . && bun eslint src demo --fix",
    "format-check": "bun prettier --check .",
    "typecheck-guards": "bun tsc --noEmit -p tsconfig.guards.json",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p tsconfig.bin.json --noEmit && bunx tsc -p tsconfig.tests.json --noEmit",
    "tests": "bun test && bun playwright test",
    "latest": "rm -rf node_modules bun.lock && bun update",
    "release-notes": "bun bin/release-notes.ts",
    "release-check": "bun bin/release-notes.ts --check",
    "stop": "bun bin/dev.ts --stop"
  },
  "keywords": [
    "tosijs",
    "ui",
    "ux",
    "user interface",
    "gui",
    "widgets",
    "web-components",
    "component library"
  ],
  "author": "Tonio Loewald",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonioloewald/xinjs-ui.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "bun-types": "latest",
    "chokidar": "^5.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "tjs-lang": "0.13.6",
    "tosijs": "1.9.1",
    "tosijs-schema": "1.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "happy-dom": "^20.7.0",
    "marked": "^16.4.2 || ^17.0.0 || ^18.0.0",
    "tjs-lang": "^0.13.1",
    "tosijs": "^1.9.1",
    "tosijs-schema": "^1.8.0",
    "chokidar": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "tjs-lang": {
      "optional": true
    },
    "chokidar": {
      "optional": true
    },
    "tosijs-schema": {
      "optional": true
    }
  },
  "files": [
    "/CHANGELOG.md",
    "/LICENSE",
    "/NOTICE",
    "/README.md",
    "/bin/caddy-install.ts",
    "/bin/deploy-preview.ts",
    "/bin/docs.ts",
    "/bin/make-icon-data.js",
    "/bin/release-notes.ts",
    "/bin/resolve-site-config.ts",
    "/bin/tunnel.ts",
    "/deploy",
    "/dist",
    "/llms.txt",
    "/tls/create-dev-certs.sh"
  ],
  "bin": {
    "tosijs-make-icons": "bin/make-icon-data.js",
    "tosijs-dev-certs": "tls/create-dev-certs.sh",
    "tosijs-tunnel": "bin/tunnel.ts",
    "tosijs-deploy": "bin/deploy-preview.ts",
    "tosijs-release-notes": "bin/release-notes.ts",
    "tosijs-caddy-install": "bin/caddy-install.ts"
  },
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./site": {
      "types": "./dist/doc-system/site/index.d.ts",
      "import": "./dist/doc-system/site/index.js",
      "default": "./dist/doc-system/site/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "default": "./dist/icons.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor.d.ts",
      "import": "./dist/code-editor.js",
      "default": "./dist/code-editor.js"
    },
    "./live-example": {
      "types": "./dist/live-example/index.d.ts",
      "import": "./dist/live-example/index.js",
      "default": "./dist/live-example/index.js"
    },
    "./doc-browser": {
      "types": "./dist/doc-browser.d.ts",
      "import": "./dist/doc-browser.js",
      "default": "./dist/doc-browser.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.js",
      "default": "./dist/diff.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7"
  },
  "overrides": {
    "flatted": ">=3.4.2",
    "brace-expansion": ">=5.0.9"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
